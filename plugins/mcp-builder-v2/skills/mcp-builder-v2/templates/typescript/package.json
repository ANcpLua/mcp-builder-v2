{
    "name": "catalog-mcp-server",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc -p .",
        "typecheck": "tsc -p . --noEmit",
        "test": "node --import tsx --test test/*.test.ts",
        "start:stdio": "node build/src/stdio.js",
        "start:http": "node build/src/http.js",
        "dev:stdio": "tsx src/stdio.ts",
        "dev:http": "tsx src/http.ts"
    },
    "dependencies": {
        "@modelcontextprotocol/express": "^2.0.2",
        "@modelcontextprotocol/node": "^2.1.1",
        "@modelcontextprotocol/server": "^2.3.1",
        "express": "^5.2.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@modelcontextprotocol/client": "^2.3.1",
        "@types/express": "^5.0.6",
        "@types/node": "^22.19.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
